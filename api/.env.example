APP_NAME=Hardwhere
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL only: the domain uses jsonb, pg_trgm, partial indexes, row locks and CHECK constraints.
# Neon: copy the *pooled or direct* connection details from the Neon console (sslmode=require). Never commit real values.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5455
DB_DATABASE=hardwhere
DB_USERNAME=hardwhere
DB_PASSWORD=change-me
DB_SSLMODE=prefer
# Or a single Neon URL:
# DB_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Hardwhere ---
VENDOR_TOKEN_TTL_MINUTES=1440
CUSTOMER_TOKEN_TTL_MINUTES=43200
# Pickup window granted when a store confirms or readies a marketplace order (minutes)
PICKUP_HOLD_MINUTES=1440
# Extra browser/WebView origins allowed by CORS (comma separated); Capacitor + localhost are built in.
# Set behind a load balancer/proxy (comma separated IPs/CIDRs, or *) so throttling uses the client IP, not the proxy's.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=
# AI: "mock" = labelled deterministic demo provider (default), "gemma" = Gemma 4 via the Gemini API.
AI_PROVIDER=mock   # mock | gemma | openai
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_API_KEY=
GEMMA_TIMEOUT=45
# Or "openrouter": any vision model through OpenRouter (set AI_PROVIDER=openrouter).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_TIMEOUT=60
# AI_PROVIDER=openai: any OpenAI-compatible vision endpoint (OpenRouter, vLLM, local Ollama at http://localhost:11434/v1)
AI_OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=
AI_OPENAI_TIMEOUT=45
AI_OPENAI_JSON_MODE=false
AI_OPENAI_MAX_TOKENS=400
AI_MODEL_IMAGE_EDGE=1024
AI_MAX_IMAGE_KB=8192
# Disable only inside wrapped test transactions.
SYNC_XMIN_HORIZON=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local inbox: `docker compose up -d mailpit`, then read mail at http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="demand@hardwhere.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
