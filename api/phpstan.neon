includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # The starter kit shipped at level 7. The marketplace domain code (generic-heavy Eloquent relations, JsonResource proxies)
    # is analysed at level 5; raising it is a documented follow-up in the README.
    level: 5

    ignoreErrors:
        # JsonResource forwards $this->column to the wrapped model through __get; static analysis cannot see through it.
        -
            identifier: property.notFound
            path: app/Http/Resources/*
        -
            identifier: method.notFound
            path: app/Http/Resources/*
